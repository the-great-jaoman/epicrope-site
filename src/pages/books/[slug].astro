---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import SimpleAddToCart from '../../components/SimpleAddToCart.astro';
import { books } from '../../data/books';

export async function getStaticPaths() {
  return books.map(item => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const canonical = `https://epicrope.com/books/${item.slug}`;
---

<BaseLayout title={item.name} description={item.description.substring(0, 160)} canonical={canonical}>
  <Breadcrumbs crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Books', href: '/books' },
    { label: item.name, href: `/books/${item.slug}` },
  ]} />

  <div id="buyrope" class="container_16">
    <h1>{item.name}</h1>

    <div style="display:flex; flex-wrap:wrap; gap:30px;">
      <div style="flex:0 0 500px; max-width:100%;">
        <ProductGallery
          images={item.detailImages}
          basePath={`/books/${item.slug}/img/`}
          alt={`Main image for ${item.name}`}
        />
      </div>

      <div style="flex:1; min-width:280px;">
        <div id="description" style="margin-bottom:15px;">
          <p>{item.description}</p>
        </div>
        <div id="price" style="font-size:24px; font-weight:bold; margin-bottom:10px;">
          ${item.price}
        </div>
        <SimpleAddToCart
          name={item.name}
          price={item.price}
          weight={item.weight}
          imageUrl={`https://epicrope.com${item.listImage}`}
        />
      </div>
    </div>
  </div>
</BaseLayout>
