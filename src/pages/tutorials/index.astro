---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tutorialCategories } from '../../data/tutorials';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="Rope Bondage Tutorials">
  <div id="tutorials_content" style="display:flex; flex-wrap:wrap; gap:30px;">
    <div id="tutorial_list" style="flex:1; min-width:300px;">
      <h1>Tutorials</h1>
      {tutorialCategories.map(cat => (
        <div class="tutorial_selection" style="margin-bottom:25px;">
          <h2><a href={`/tutorials/${cat.slug}`} style="color:red;">{cat.name}</a></h2>
          <ul style="margin:0; padding-left:20px;">
            {cat.subcategories.map(sub => (
              <li style="margin-bottom:6px;">
                <b>{sub.name}:</b>
                {sub.tutorials.filter(t => t.image).map((t, i) => (
                  <>{i > 0 && ', '}<a href={`/tutorials/${cat.slug}/${sub.slug}/${t.slug}`}>{t.title}</a></>
                ))}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div id="tutorial_categories" style="flex:0 0 200px;">
      <h3>Categories</h3>
      <ul style="list-style:none; padding:0;">
        {tutorialCategories.map(cat => (
          <li style="margin-bottom:8px;">
            <a href={`/tutorials/${cat.slug}`} style="color:red;">{cat.name}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>
