---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import KitButtons from '../../components/KitButtons.astro';
import RopeCustomForm from '../../components/RopeCustomForm.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const title = "Rainbow Hemp Bondage Rope - $1.30 per foot";
const desc = "Beautiful tie-dyed rainbow hemp rope for shibari and kinbaku bondage. Hand-dyed for a spectacular multi-color effect.";
const canonical = `${import.meta.env.SITE}${base}hemp/rainbow_rope`;
---

<BaseLayout title={title} description={desc} canonical={canonical}>
  <Breadcrumbs crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Rainbow Rope', href: '/rainbow_rope' },
    { label: 'Rainbow Hemp', href: '/hemp/rainbow_rope' },
  ]} />

  <div id="buyrope" class="container_16">
    <h1>Rainbow Hemp Bondage Rope - $1.30 per foot</h1>

    <div style="display:flex; flex-wrap:wrap; gap:30px;">
      <div style="flex:0 0 500px; max-width:100%;">
        <img src={`${base}rainbow_rope/hemp/img/main.png`} alt="Rainbow hemp rope for rope bondage" style="border:1px solid #ccc; padding:4px; max-width:100%;" />
      </div>

      <div style="flex:1; min-width:280px;">
        <KitButtons
          fiberName="Hemp"
          fiberSlug="hemp"
          colorName="Rainbow"
          colorSlug="rainbow"
          pricePerFoot={1.30}
        />

        <div style="clear:both;"></div>

        <RopeCustomForm
          fiberName="Hemp"
          fiberSlug="hemp"
          colorName="Rainbow"
          colorSlug="rainbow"
          pricePerFoot={1.30}
          weightPerFoot={0.0080}
          diameter="6mm"
        />
      </div>
    </div>

    <div style="clear:both;"></div>

    <br /><br />

    <div id="desc_box" class="card" style="margin-top:20px;">
      <h4>About the rope:</h4>
      <p><b>Rainbow Hemp:</b> Our rainbow tie-dyed hemp rope combines the soft, strong qualities of premium hemp with a spectacular multi-color effect. Each rope is hand-dyed, making every piece unique.</p>
    </div>
  </div>
</BaseLayout>

<script is:inline src={`${base}scripts/rope-builder.js`}></script>
