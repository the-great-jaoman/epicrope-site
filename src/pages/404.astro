---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <div style="text-align:center; padding:60px 20px;">
    <h1 style="font-size:48px; color:#000; margin-bottom:20px;">404</h1>
    <h2 style="color:#000; margin-bottom:20px;">Page Not Found</h2>
    <p style="margin-bottom:30px;">The page you are looking for does not exist. It may have been moved or renamed.</p>
    <a href="/" style="display:inline-block; padding:10px 30px; border:1px solid #ccc; background:#f5f5f5; color:red; font-weight:bold; text-decoration:none; border-radius:4px;">Return to Homepage</a>
  </div>
</BaseLayout>
