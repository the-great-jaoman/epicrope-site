---
export interface Props {
  title: string;
  href: string;
  imageSrc: string;
}
const { title, href, imageSrc } = Astro.props;
---

<a href={href} class="tutorial_link" style="display:inline-block; margin:0 10px 20px 0; text-align:center; text-decoration:none; width:140px; vertical-align:top;">
  <img src={imageSrc} class="tutorial_image" style="width:120px; height:90px; border:1px solid #ccc; padding:3px;" alt={title} />
  <div class="tutorial_name" style="font-size:12px; color:red; margin-top:5px;">{title}</div>
</a>
